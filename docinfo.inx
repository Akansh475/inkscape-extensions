<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
      <name>DOC Info</name>
      <id>org.inkscape.docinfo</id>
      <param name="action" type="notebook" gui-hidden="true">
        <page name="page_info" gui-text="Show page info">
            <label>Choose this tab if you would like to information about the document before switching the DPI value.</label>
        </page>
      </param>
      <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
          <submenu name="Document"/>
        </effects-menu>
      </effect>
      <script>
        <command location="inx" interpreter="python">dpiswitcher.py</command>
      </script>
</inkscape-extension>
