<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Seamless Pattern</name>
    <id>org.inkscape.render.seamless_pattern</id>
    <dependency type="executable" location="extensions">seamless_pattern.py</dependency>
    <param name="width"  gui-text="Custom Width (px):"  type="int" min="1" max="99999999">100</param>
    <param name="height" gui-text="Custom Height (px):" type="int" min="1" max="99999999">100</param>
    <label>This extension overwrites the current document</label>

    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu>
            <submenu name="Render"/>
        </effects-menu>
    </effect>
    <script>
        <command reldir="extensions" interpreter="python">seamless_pattern.py</command>
    </script>
</inkscape-extension>
