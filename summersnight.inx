<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
    <name>Envelope</name>
    <id>org.ekips.filter.summersnight</id>
    <dependency type="executable" location="extensions">summersnight.py</dependency>
    <effect>
    <object-type>path</object-type>
        <effects-menu>
            <submenu name="Modify Path"/>
        </effects-menu>
    </effect>
    <script>
        <command reldir="extensions" interpreter="python">summersnight.py</command>
    </script>
</inkscape-extension>
