<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension" xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape">
    <_name>Envelope</_name>
    <id>org.inkscape.render.envelope</id>
    <dependency type="executable" location="extensions">empty_page.py</dependency>

    <param name="size" _gui-text="Envelope size:" type="enum">
        <item value="dl">DL — 220 x 110 mm</item>
        <item value="no10">No. 10 — 9.5 × 4.125 in</item>
    </param>

    <effect needs-live-preview="false">
        <object-type>all</object-type>
        <effects-menu hidden="true" />
    </effect>
    <inkscape:_templateinfo>
      <inkscape:_name>Envelope...</inkscape:_name>
      <inkscape:author>Windell Oskay</inkscape:author>
      <inkscape:_shortdesc>Blank envelope of chosen size.</inkscape:_shortdesc>
      <inkscape:date>2019-07-11</inkscape:date>
      <inkscape:_keywords>empty envelope dl no10</inkscape:_keywords>
    </inkscape:_templateinfo>
    <script>
        <command reldir="extensions" interpreter="python">empty_envelope.py</command>
    </script>
</inkscape-extension>
