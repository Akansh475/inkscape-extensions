<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>rANdOm CasE</name>
  <id>org.inkscape.text.randomcase</id>
  <dependency type="executable" location="inx">chardataeffect.py</dependency>
  <dependency type="executable" location="inx">text_randomcase.py</dependency>
  <effect>
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="Text">
        <submenu name="Change Case" />
      </submenu>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">text_randomcase.py</command>
  </script>
</inkscape-extension>
